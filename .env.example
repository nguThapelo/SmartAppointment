# ─────────────────────────────────────────────────────────────────────────────
# Appointment Hub — environment variables
# Copy to `.env` for local development. Never commit real values.
# In Amplify, set these in the console; amplify.yml writes them into
# .env.production so the SSR runtime can read them.
# ─────────────────────────────────────────────────────────────────────────────

# App
APP_URL=http://localhost:3000

# Neon Postgres
#   DATABASE_URL        → pooled connection (host contains "-pooler"), used at runtime
#   DIRECT_DATABASE_URL → direct connection, used by `prisma migrate`
# Local dev with Docker:  postgresql://postgres:postgres@localhost:5432/appointmenthub
DATABASE_URL=
DIRECT_DATABASE_URL=

# Session signing secret — at least 32 random chars (e.g. `openssl rand -hex 32`)
SESSION_SECRET=

# Shared secret GitHub Actions sends to /api/cron/* (Authorization: Bearer <value>)
CRON_SECRET=

# First admin, created by `npm run db:seed`
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Demo data for showcase / staging environments (catalogue, 2 providers, a client, bookings)
SEED_DEMO=false
SEED_DEMO_PASSWORD=
# Optional: a real Meta test number for the demo WhatsApp channel
SEED_WHATSAPP_PHONE_NUMBER_ID=
SEED_WHATSAPP_DISPLAY_NUMBER=

# S3 (private bucket; see docs/deploy). AWS_* keys are for LOCAL dev only —
# in Amplify the SSR compute role grants S3 access and AWS_* vars are reserved.
S3_BUCKET_NAME=
AWS_REGION=af-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Stripe — TEST MODE keys only (sk_test_… / whsec_…)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Meta WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v21.0
# Local dev ONLY: skip webhook signature checks. Refused when NODE_ENV=production.
WHATSAPP_INSECURE_DEV=false

# AI assistant
AI_ENABLED=true
GEMINI_API_KEY=
# Optional second provider in the fallback chain
ANTHROPIC_API_KEY=
# Pin one provider for the whole deployment (gemini | anthropic); empty = fallback chain
AI_ACTIVE_PROVIDER=
AI_DAILY_USER_LIMIT=30
AI_DAILY_GLOBAL_LIMIT=400

# Email (SMTP, e.g. Gmail app password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Appointment Hub <no-reply@example.com>"

# Google Calendar (optional; OAuth refresh-token flow)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# ============================================================
# SmartAppointment WhatsApp Bot — Environment Variables
# Copy this file to .env.local and fill in your values
# ============================================================

# App
PORT=8000
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:8000

# ── Supabase ──────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# ── Twilio WhatsApp ───────────────────────────────────────────
# Get these from https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
# Default/fallback WhatsApp number (format: whatsapp:+14155238886)
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
# Twilio sandbox join code (for development sandbox)
# TWILIO_SANDBOX_KEYWORD=join your-keyword

# ── SMTP Email ────────────────────────────────────────────────
# Gmail example: host=smtp.gmail.com, port=587
# Outlook: host=smtp.office365.com, port=587
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM_NAME=SmartAppointment
SMTP_FROM_EMAIL=noreply@yourdomain.com

# ── Google Calendar ───────────────────────────────────────────
# 1. Go to https://console.cloud.google.com
# 2. Create OAuth2 credentials
# 3. Use OAuth2 Playground to get a refresh token
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://developers.google.com/oauthplayground
GOOGLE_REFRESH_TOKEN=your-refresh-token
# Calendar ID to add events to (use 'primary' for the main calendar)
GOOGLE_CALENDAR_ID=primary

# ── Stripe (existing) ─────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx

# ── Security (existing) ───────────────────────────────────────
CSRF_SECRET=a-long-random-secret-string
ENCRYPTION_KEY=another-long-random-secret-32char

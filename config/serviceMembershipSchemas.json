            { "name": "medicalAid.provider", "label": "Medical Aid Provider", "type": "text" },
            { "name": "medicalAid.plan", "label": "Plan/Option", "type": "text" },
            { "name": "medicalAid.memberNumber", "label": "Membership Number", "type": "text" }
          ]
        },
        {
          "title": "Medical History",
          "fields": [
            { "name": "history.conditions", "label": "Chronic Conditions", "type": "textarea", "rows": 3 },
            { "name": "history.surgeries", "label": "Past Surgeries/Hospitalisations", "type": "textarea", "rows": 3 },
            { "name": "history.allergies", "label": "Allergies", "type": "textarea", "rows": 2 },
            { "name": "history.medications", "label": "Current Medications", "type": "textarea", "rows": 3 }

        },
        {
          "title": "Beneficiaries",
          "fields": [
            { "name": "beneficiaries.primary", "label": "Primary Beneficiary", "type": "text" },
            { "name": "beneficiaries.secondary", "label": "Secondary Beneficiaries", "type": "textarea", "rows": 2 },
            { "name": "beneficiaries.relationships", "label": "Relationships", "type": "textarea", "rows": 2 }
          ]
        },
        {
          "title": "Claims History",
          "fields": [
            { "name": "claims.pastClaims", "label": "Past Claims", "type": "textarea", "rows": 3 },
            { "name": "claims.openClaims", "label": "Open Claims", "type": "textarea", "rows": 2 },
            { "name": "claims.notes", "label": "Notes", "type": "textarea", "rows": 2 }
          ]
        }
      ]

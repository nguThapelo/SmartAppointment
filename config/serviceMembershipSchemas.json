        },
        {
          "title": "Lifestyle",
          "fields": [
            { "name": "lifestyle.dietPreferences", "label": "Diet Preferences", "type": "textarea", "rows": 2 },
            { "name": "lifestyle.productsUsed", "label": "Products Currently Used", "type": "textarea", "rows": 2 }
          ]
        }
      ]
    },

        {
          "title": "Lifestyle",
          "fields": [
            { "name": "lifestyle.smoking", "label": "Do you smoke?", "type": "select", "options": ["No", "Occasionally", "Daily"] },
            { "name": "lifestyle.alcohol", "label": "Alcohol consumption", "type": "select", "options": ["Never", "Occasional", "Weekly", "Daily"] },
            { "name": "lifestyle.activityLevel", "label": "Activity Level", "type": "select", "options": ["Sedentary", "Light", "Moderate", "Intense"] }
          ]
        }
      ]
    },

            { "name": "history.weightChanges", "label": "Recent weight changes", "type": "textarea", "rows": 2 },
            { "name": "history.medicalConditions", "label": "Medical conditions", "type": "textarea", "rows": 3 }
          ]
        },
        {
          "title": "Constraints",
          "fields": [
            { "name": "constraints.foodAllergies", "label": "Food allergies", "type": "textarea", "rows": 2 },
            { "name": "constraints.intolerances", "label": "Intolerances", "type": "textarea", "rows": 2 },
            { "name": "constraints.exerciseHabits", "label": "Exercise habits", "type": "textarea", "rows": 2 }
          ]
        }
      ]
    },
    "insurance": {
      "title": "Insurance Membership Form",
      "description": "Capture policy, beneficiary, and claims insights.",
      "sections": [
        {
          "title": "Policy Details",
          "fields": [
            { "name": "policy.provider", "label": "Carrier", "type": "text", "required": true },
            { "name": "policy.policyNumber", "label": "Policy Number", "type": "text", "required": true },
            { "name": "policy.coverageTypes", "label": "Coverage Types", "type": "textarea", "rows": 3 }

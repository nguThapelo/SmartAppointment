{
  "profiles": {
    "default": {
      "title": "Membership Profile",
      "description": "General intake covering identity, contact info, and preferences.",
      "sections": [
        {
          "title": "Personal Details",
          "fields": [
            { "name": "personal.fullName", "label": "Full Name", "type": "text", "required": true },
            { "name": "personal.dateOfBirth", "label": "Date of Birth", "type": "date" },
            { "name": "personal.gender", "label": "Gender", "type": "select", "options": ["Female", "Male", "Non-binary", "Prefer not to say"] }
          ]
        },
        {
          "title": "Contact & Address",
          "fields": [
            { "name": "contact.email", "label": "Email", "type": "text" },
            { "name": "contact.phone", "label": "Phone", "type": "text" },
            { "name": "contact.addressLine1", "label": "Address Line 1", "type": "text" },
            { "name": "contact.city", "label": "City", "type": "text" },
            { "name": "contact.country", "label": "Country", "type": "text" }
          ]
        },
        {
          "title": "Preferences",
          "fields": [
            { "name": "preferences.notes", "label": "General Notes", "type": "textarea", "rows": 3 }
          ]
        }
      ]
    },
    "medical": {
